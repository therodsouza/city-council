# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=75407284544-revpdnf11vh8jbufj7682k0bv2ietk1p.apps.googleusercontent.com

# AWS Cognito Configuration
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:435aad9c-bfa4-4582-91e4-d2ded25f45dc
VITE_COGNITO_REGION=us-east-1

# Application Configuration
VITE_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OAUTH_SCOPES=openid,email,profile
VITE_API_URL=https://api.example.com
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Cloudflare Turnstile SITE key (public) for submitting without an account.
# Never put the secret key here; it belongs to the API.
# For local dev Cloudflare's always-passes test key is: 1x00000000000000000000AA
# Leave VITE_API_URL unset to run the whole guest flow against built-in mocks
# (SMS code 123456, no captcha).
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# How guests receive their verification code: sms (default), email, or off
# (hides "continue without an account"). The API must have the channel enabled.
VITE_GUEST_VERIFICATION=sms

# Security Configuration
# Set true to refuse the auth flow over HTTP (recommended in production).
VITE_HTTPS_ONLY=false

# Deployment Configuration (not exposed to the browser)
DEPLOY_S3_BUCKET=your-bucket-name
DEPLOY_CF_DISTRIBUTION_ID=EXXXXXXXXXXXXX
